#!/usr/bin/env python3
"""thingskit — CLI d'accès à Things 3 (Cultured Code) pour le harness agentique.

Pourquoi cet outil existe
-------------------------
La skill `things` ne porte que l'usage : aucun code, et surtout aucun code
généré à la volée — un script réécrit à chaque appel n'est jamais deux fois le
même, donc jamais testé. Tout ce que le harness sait faire avec Things passe
par ici, où c'est versionné, lisible et vérifiable.

Ce que Things permet, et ce qu'il ne permet pas
-----------------------------------------------
Constaté par test le 2026-08-11, pas déduit de la documentation :

  Area            créer          -> AppleScript (`make new area`)
                  créer via JSON -> NON : le schéma d'URL ignore SILENCIEUSEMENT
                                    une area inexistante et laisse le projet sans
                                    rattachement, sans lever d'erreur
                  notes          -> NON : une area n'a pas de champ notes
  Projet          créer          -> JSON (`things:///json`), area par son nom
                  notes          -> AppleScript (`set notes of project`), ou
                                    par identifiant : `to do id "<uuid de
                                    projet>"` résout aussi (la classe `project`
                                    hérite de `to do`), ce qui donne
                                    `--project-id`, seule voie utilisable
                                    depuis le vault qui ne connaît que
                                    `things_id`, jamais les titres Things
  Heading         créer (projet   -> JSON, dans `items` à la création du projet
                  neuf)              (`create-project --heading`)
                  créer (projet   -> AUCUNE surface API (URL scheme, JSON,
                  existant)          AppleScript) ne l'expose. Seule
                                    l'automatisation d'interface fonctionne
                                    (menu Fichier > "Nouvel en-tête" ou
                                    équivalent localisé) : `create-heading`
                  notes          -> NON. `to do id "<uuid de heading>"` RÉSOUT
                                    et `set notes` y retourne 0, mais la valeur
                                    n'est ni relue par AppleScript ni présente
                                    en base ensuite : l'ordre est un no-op
                                    SILENCIEUX (mesuré le 2026-08-12 sur la
                                    vraie base). Un heading est donc refusé
                                    avant tout envoi — c'est le mode d'échec
                                    « commande envoyée ≠ effet constaté »
  Tâche           créer          -> JSON ; `list` = projet ou area,
                                    `heading` = heading existant. Un `list`
                                    qui ne nomme NI projet NI area est ignoré
                                    silencieusement : la tâche atterrit en
                                    Inbox et `open` rend malgré tout 0 —
                                    même mode d'échec que l'area inexistante
                                    ci-dessus (constaté le 2026-08-12 par
                                    l'utilisateur, BUG-005 ; non re-mesuré
                                    ici, le mesurer imposerait d'écrire dans
                                    la base réelle). D'où la résolution de la
                                    cible AVANT l'envoi, et la vérification du
                                    RATTACHEMENT après coup — l'existence de
                                    la tâche, elle, est vraie dans les deux
                                    cas et ne prouve donc rien
                  sous heading   -> son champ `project` reste VIDE en base.
                                    Compter les tâches d'un projet en joignant
                                    sur `project` les rate toutes
                  terminer       -> AppleScript (`set status of to do id … to
                                    completed`). Constaté le 2026-08-12 par
                                    `sdef /Applications/Things3.app` : `status`
                                    est une propriété rw de la classe `to do`,
                                    d'énumération open|completed|canceled — donc
                                    PAS besoin d'automatisation d'interface,
                                    contrairement au heading : `complete-task`
                  notes          -> AppleScript (`set notes of to do id … to …`).
                                    `notes` est déclarée sans attribut `access`
                                    dans le dictionnaire de la classe `to do`,
                                    donc rw par défaut comme `name` : aucune
                                    frappe clavier en jeu, un saut de ligne y
                                    est un contenu légitime.
                                    Fidélité MESURÉE de bout en bout le
                                    2026-08-12 sur une tâche jetable réelle
                                    (accents, tiret cadratin, LF, CR, CRLF,
                                    tabulation, URI percent-encodée, guillemet
                                    et antislash, emoji hors BMP, U+2028) :
                                    la valeur relue en base est
                                    exactement la chaîne envoyée, AUCUNE classe
                                    n'est altérée — donc aucune n'est refusée
                  où elle apparaît -> le couple (`start`, `startDate`), jamais
                                    `start` seul. Table MESURÉE le 2026-08-12
                                    en croisant `to dos of list "<libellé>"`
                                    avec la base, re-mesurée le 2026-08-12
                                    (BUG-001) sur 610 tâches ouvertes :
                                      start=0 sans date -> À classer     (126)
                                      start=1 sans date -> À tout moment (458)
                                      start=1 avec date -> Aujourd'hui   (11)
                                      start=2 sans date -> Un jour       (1)
                                      start=2 avec date -> À venir       (14)
                                    Contresens à éviter : lire `start=2` comme
                                    « Un jour ». Une tâche planifiée à une date
                                    future porte bien `start=2` ; forcer 1 la
                                    ferait basculer dans Aujourd'hui
                  replanifier    -> AppleScript ciblé : `schedule … for <date>`
                                    pour une date, `move … to list "<libellé>"`
                                    pour Aujourd'hui / À tout moment / Un jour,
                                    `set due date` et `delete due date` pour
                                    l'échéance : `reschedule-task`. Mesuré le
                                    2026-08-17 sur une tâche jetable réelle,
                                    cinq constats qui commandent le design :
                                    (1) le schéma d'URL `operation: "update"`
                                    EXIGE un jeton d'authentification (Things >
                                    Réglages > Général) ; sans jeton l'app
                                    affiche une boîte de dialogue et NE MUTE
                                    RIEN — no-op silencieux côté script, donc
                                    surface écartée, pas « tentée » ;
                                    (2) `activation date` est access="r"
                                    (la poser lève -10006) : le `when` passe
                                    par la commande `schedule`, pas par la
                                    propriété ;
                                    (3) un littéral `date "2026-09-05"` est
                                    interprété selon la LOCALE de la session et
                                    a produit 2011-03-19 — toute date est
                                    construite champ par champ
                                    (`set year/month/day`), jamais en chaîne ;
                                    (4) `set due date … to missing value` lève
                                    -1700 ; c'est `delete due date` qui retire
                                    l'échéance ;
                                    (5) `schedule … for (current date)` pose
                                    start=2 + date du jour = « À venir », PAS
                                    « Aujourd'hui » (start=1 + date) : celui-ci
                                    s'obtient par `move to list`, dont les
                                    libellés sont LOCALISÉS (`exists list
                                    "Anytime"` -> false, `"À tout moment"` ->
                                    true sur ce poste) — d'où une liste de
                                    candidats, comme pour le menu de heading.
                                    Non couvert, donc REFUSÉ explicitement :
                                    `evening` (aucune liste « Ce soir » /
                                    « Evening » n'existe) et le suffixe
                                    `@HH:MM` (`reminderTime` n'est exposé par
                                    aucune propriété AppleScript).
                                    `schedule` sur une tâche `completed`
                                    RÉUSSIT et laisse le statut inchangé : la
                                    date atterrit sur un objet absent de toute
                                    liste, d'où le refus en amont
                  rouvrir        -> AppleScript ciblé, même propriété `status`
                                    que `terminer`/`annuler` mais dans l'autre
                                    sens : `set status … to open`. Ajoutée le
                                    2026-08-24, en rupture assumée avec le
                                    principe initial de `complete-task` /
                                    `cancel-task` (« aucune opération inverse
                                    n'est exposée ») : ce principe protégeait
                                    une DÉCISION affirmée, pas une ERREUR de
                                    fermeture (ex. un lot de complétions qui
                                    emporte des tâches encore vraies).
                                    `reopen-task` accepte indifféremment
                                    `completed` ET `canceled` comme état de
                                    départ — contrairement aux deux commandes
                                    voisines, qui refusent chacune l'état de
                                    l'autre : `reopen-task` est précisément
                                    l'opération qui manquait aux deux, et leurs
                                    messages de refus doivent le dire plutôt
                                    que d'affirmer qu'aucune n'existe

La lecture ne passe jamais par AppleScript : elle interroge la base SQLite en
lecture seule (`mode=ro`), ce qui est plus rapide, scriptable, et ne dépend pas
de l'application au premier plan.

Le schéma d'URL ne sait pas SUPPRIMER sans jeton d'authentification (réglages
Things). Les suppressions passent donc par AppleScript, qui n'en demande pas.

Délai d'enregistrement d'une écriture — MESURÉ le 2026-08-25 (Mac Studio,
Things 3.23), par sondage de `main.sqlite` toutes les 25 ms jusqu'à constat,
plafond 10 s, sur 10 tâches jetables :

    création par schéma d'URL   n=5    médiane  11 ms   max   66 ms
    création par AppleScript    n=5    médiane  13 ms   max   14 ms
    renommage                   n=10   médiane  11 ms   max   14 ms
    complétion                  n=10   médiane  11 ms   max   14 ms
    mise à la Corbeille         n=10   médiane  23 ms   max 5026 ms

Deux constats commandent le design de l'attente post-écriture (BUG-016) :
(1) l'enregistrement est de l'ordre de 11-23 ms, soit ~130x moins que les
attentes fixes de 1500-2500 ms qui le précédaient ; (2) la queue existe et
dépasse ces plafonds — une suppression sur dix a mis 5026 ms, cas où la
relecture tombait avant l'effet et où la commande sortait en échec sur une
écriture pourtant réussie. L'attente est donc une BOUCLE DE RELECTURE BORNÉE
(`wait_for_effect`), jamais une durée devinée. Mesuré le même jour, la
composante attente d'un cycle réel tombe de 1500-2500 ms fixes à 0-25 ms :
`osascript` rend la main après que Things a appliqué le changement, donc la
toute première relecture constate déjà l'effet (0 sondage sur rename /
complete / delete, 1 sur add-task, qui écrit par schéma d'URL — asynchrone).

`create-heading` a une SECONDE attente, de nature différente : le clic de
menu s'applique à la fenêtre au premier plan, et il faut que Things ait
affiché le projet visé. Cette condition-là n'a aucune trace en base, mais
elle s'observe par la surface applicative (`name of window 1`), donc elle est
sondée elle aussi. Mesuré le 2026-08-25 sur 3 démarrages à froid :
`pgrep -x Things3` matche à 57-62 ms, la fenêtre affiche le projet à
795-970 ms. Un AppleEvent adressé à l'application EN COURS DE LANCEMENT ne
rend pas `-600` : il BLOQUE jusqu'à pouvoir être servi (699, 753, 854 ms,
rc=0) — d'où la borne `with timeout of` posée dans la sonde, sans quoi
l'attente serait bornée par le délai d'AppleEvent d'`osascript` (120 s) et
non par le plafond de la boucle. Écartés parce que MESURÉS inopérants sur
cette version : `current list url` et `current list name`, propriétés cachées
du dictionnaire, rendent `missing value`.

Usage
-----
    thingskit areas [--json]
    thingskit projects [--area NOM] [--json]
    thingskit headings [--project TITRE] [--json]
    thingskit tasks [--project TITRE] [--area NOM] [--inbox] [--json]
    thingskit uuid --type area|project|heading --title TITRE
    thingskit find-task TITRE --list CIBLE [--heading H] [--json]
    thingskit create-area NOM
    thingskit create-project TITRE --area NOM [--notes TEXTE] [--heading H]...
    thingskit create-heading TITRE --project TITRE
    thingskit add-task TITRE --list CIBLE [--heading H] [--notes TEXTE]
    thingskit set-notes --project TITRE|--project-id UUID --notes TEXTE
    thingskit set-notes --task TITRE|--task-id UUID --notes TEXTE
    thingskit append-notes --project TITRE|--project-id UUID --line LIGNE
    thingskit append-notes --task TITRE|--task-id UUID --line LIGNE
    thingskit complete-task [--id UUID] [--title TITRE]
    thingskit cancel-task [--id UUID] [--title TITRE]
    thingskit reopen-task [--id UUID] [--title TITRE]
    thingskit rename-task [--id UUID] [--title TITRE] --new-title TITRE
    thingskit reschedule-task [--id UUID] [--title TITRE] [--when VAL]
                              [--deadline AAAA-MM-JJ] [--clear-deadline]
    thingskit move-task [--id UUID] [--title TITRE]
                        --to-project TITRE [--to-heading H] | --to-area NOM
    thingskit move-project --project TITRE|--project-id UUID --area NOM
    thingskit deeplink --type project|area|task --title TITRE

Toutes les sous-commandes de lecture acceptent `--json`. Les sous-commandes
d'écriture affichent ce qu'elles ont fait et sortent en code non nul si la
vérification post-écriture échoue.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import sqlite3
import subprocess
import sys
import time
import unicodedata


# --------------------------------------------------------------- BUG-009
# Identité de code de l'entrée CLI (ADR-001, INV-001-1).
#
# Le grant TCC `kTCCServiceSystemPolicyAppData` est accordé à une IDENTITÉ DE
# CODE, pas à un fichier. Lancer ce script sous un interpréteur de passage
# (Homebrew, Xcode, venv) accède donc à la base de Things sous l'identité de
# CET interpréteur — d'où une invite d'autorisation par interpréteur, et une
# nouvelle à chaque `brew upgrade python` (mesuré : deux entrées TCC pour
# python@3.14.6 et 3.14.7). C'est exactement le défaut qu'ADR-001 élimine, par
# un chemin d'appel qui n'était pas couvert.
#
# Le discriminant est la SIGNATURE de l'interpréteur en cours, opposée à
# l'exigence de code du bundle — le même contrôle que fait le lanceur sur le
# bundle. Un critère satisfaisable par accident (variable d'environnement,
# nom de fichier, répertoire parent) ne vaudrait rien : il suffirait de le
# poser pour retrouver l'invite. `-R` n'est pas optionnel — sans lui, codesign
# constate « une signature valide », jamais « LA signature » (une copie
# re-signée ad-hoc repassait à rc=0, mesuré le 2026-08-18).
#
# La garde porte UNIQUEMENT sur `__main__` : `tests/conftest.py` charge ce
# fichier comme module via `SourceFileLoader`, et un refus au niveau module
# casserait toute la suite sans rien protéger de plus.
# ADR-003 : le script ne porte plus AUCUNE valeur d'identité. Quelle identité
# est attendue est une donnée du bundle, écrite dans `Contents/Resources/` par
# le build et scellée par la signature — lue ici par chemin absolu dérivé de
# `sys.executable` RÉSOLU, et parsée comme DONNÉE, jamais importée : `-I`
# n'implique pas `-S` et ne ferme pas l'ombrage par un module homonyme du
# répertoire courant (motif mesuré, build/bundle.py). Un `import` sur le
# chemin de démarrage de la garde serait une surface d'exécution.
#
# Motif de ce déplacement : une valeur écrite ici liait le dépôt public à
# l'équipe du mainteneur, et `verify_embedded_copy` (build/bundle.py) interdit
# par construction qu'une valeur par poste soit générée dans ce fichier — il
# doit rester identique à l'octet près à la copie embarquée.
CODE_IDENTITY_FILE = "code-identity"
# Chemin ABSOLU : un vérificateur que `PATH` peut détourner ne vérifie rien.
CODESIGN = "/usr/bin/codesign"
# Marqueur d'extension X.509 du TYPE de certificat (ADR-002 § Decision 5). Le
# `csreq` que TCC a enregistré pinne le CN de la feuille, jamais le Team ID :
# sans ce discriminant, un bundle re-signé sous un certificat d'un autre type
# (Developer ID Application) satisferait cette exigence tout en ayant perdu le
# grant. Rationale complète et limite non établie : build/bundle.py.
CERTIFICATE_TYPE_OID = "1.2.840.113635.100.6.1.2"
# Formes admises des deux champs. Elles sont STRICTES, pas seulement
# échappables : tout ce qui sort de ces classes est le signe que le fichier ne
# dit pas ce qu'on croit, et un échappement correct rendrait le défaut
# silencieux au lieu de le nommer. Ni guillemet, ni espace, ni caractère de
# contrôle ne peut donc entrer dans l'exigence composée plus bas.
BUNDLE_IDENTIFIER_FORM = re.compile(r"[A-Za-z0-9][A-Za-z0-9.-]{0,127}\Z")
# L'unité d'organisation d'un certificat Apple est l'identifiant d'équipe :
# dix caractères alphanumériques en capitales.
TEAM_IDENTIFIER_FORM = re.compile(r"[A-Z0-9]{10}\Z")
CODE_IDENTITY_FIELDS = ("bundle_identifier", "team_identifier")
LAUNCHER_HINT = "~/.local/bin/thingskit"
# `codesign` peut se bloquer (volume réseau, `AppleMobileFileIntegrity`
# occupé). Sans borne, toute invocation du CLI pendrait indéfiniment et sans
# message : le refus par défaut serait préservé, mais jamais rendu. Lue à
# l'appel (pas figée en défaut de `def`) pour rester substituable en test.
CODESIGN_TIMEOUT = 10
# Distinct de tout code du chemin nominal (`main` rend 0/1, argparse 2) ET du
# refus de sceau du lanceur (126) : les deux causes ne se confondent pas.
IDENTITY_REFUSAL_CODE = 125


def _requirement_value(value: str, form: "re.Pattern[str]") -> str:
    """Rend `value` si elle satisfait `form`, LÈVE sinon.

    Neutraliseur par REFUS, là où `_esc` neutralise par échappement — et c'est
    la bonne forme ici : la grammaire de `csreq` n'est pas celle d'AppleScript,
    et échapper un guillemet y ferait passer une valeur que ce dépôt veut voir
    refusée. Le contrôle est réaffirmé AU SITE d'interpolation, et pas
    seulement à la lecture du fichier : c'est là que la valeur rencontre le
    gabarit, donc là que l'injection se joue.
    """
    if not form.match(value):
        raise ValueError(
            f"valeur hors forme pour une exigence de code : {value!r}")
    return value


def compose_code_requirement(bundle_identifier: str, team_identifier: str) -> str:
    """Compose l'exigence de code opposée à l'interpréteur.

    Le PLANCHER de forme n'est pas configurable : l'ancrage Apple générique et
    le marqueur d'extension de TYPE de certificat sont écrits ici, et aucune
    donnée lue ne peut les retirer. Sans ce plancher, un fichier d'identité
    dégradé affaiblirait la garde en silence — la seule dégradation invisible,
    puisque le CLI démarrerait quand même.
    """
    return (
        "anchor apple generic"
        f' and identifier '
        f'"{_requirement_value(bundle_identifier, BUNDLE_IDENTIFIER_FORM)}"'
        f' and certificate leaf[field.{CERTIFICATE_TYPE_OID}] exists'
        f' and certificate leaf[subject.OU]='
        f'"{_requirement_value(team_identifier, TEAM_IDENTIFIER_FORM)}"'
    )


def code_identity_path(executable: str | None = None) -> str:
    """Chemin du fichier d'identité scellé, à côté de l'interpréteur RÉSOLU.

    Résolu, parce qu'un lien symbolique déplacerait la source de l'attente
    sans déplacer le code qui l'exécute.
    """
    exe = Path(executable or sys.executable).resolve()
    return str(exe.parent.parent / "Resources" / CODE_IDENTITY_FILE)


def parse_code_identity(text: str) -> tuple[str, str]:
    """Rend le couple (identifiant de bundle, équipe) lu dans le fichier.

    Lève `ValueError` sur TOUTE forme dégénérée — fichier vide, ligne sans
    séparateur, champ inconnu, dupliqué, manquant, vide ou hors forme. Aucune
    tolérance : ce fichier décide de ce à quoi l'interpréteur est comparé.
    Les valeurs fautives sont CONVERTIES (`!r`) dans le message, jamais
    recopiées — le fichier peut n'être pas scellé, c'est même le cas où cette
    fonction refuse, donc son contenu est d'origine non contrôlée.
    """
    fields: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        if not sep:
            raise ValueError(f"ligne sans separateur : {line!r}")
        key, value = key.strip(), value.strip()
        if key not in CODE_IDENTITY_FIELDS:
            raise ValueError(f"champ inconnu : {key!r}")
        if key in fields:
            raise ValueError(f"champ duplique : {key!r}")
        fields[key] = value
    for name in CODE_IDENTITY_FIELDS:
        if name not in fields:
            raise ValueError(f"champ manquant : {name!r}")
    identifier, team = fields["bundle_identifier"], fields["team_identifier"]
    if not BUNDLE_IDENTIFIER_FORM.match(identifier):
        raise ValueError(f"identifiant de bundle hors forme : {identifier!r}")
    if not TEAM_IDENTIFIER_FORM.match(team):
        raise ValueError(f"identifiant d'equipe hors forme : {team!r}")
    return identifier, team


def expected_code_identity(executable: str | None = None, reader=None):
    """Rend `((identifiant, equipe), None)`, ou `(None, message de refus)`.

    Fermé par défaut : fichier absent, illisible, indécodable ou malformé →
    l'attente n'est pas établie, donc l'exécution est refusée. `ValueError`
    couvre l'indécodable (`UnicodeDecodeError`) comme le malformé.
    """
    path = code_identity_path(executable)
    try:
        if reader is not None:
            text = reader(path)
        else:
            # Lecture INLINE, sans passer par un helper nommé : le balayage de
            # la partition du régime rapide refuse une fonction de module
            # employée comme VALEUR (`tests/test_fast_path_partition.py`) —
            # une référence indirecte l'empêcherait de suivre les appels.
            with open(path, "r", encoding="utf-8") as handle:
                text = handle.read()
        fields = parse_code_identity(text)
    except (OSError, ValueError) as exc:
        # `_rendered` sur l'exception, pas sur ses seules parties : le message
        # de `parse_code_identity` est déjà composé avec `!r` sur les valeurs
        # fautives, mais s'en remettre à ça ferait reposer la borne sur une
        # relecture croisée de deux fonctions — exactement ce dont ce dépôt se
        # méfie. Le fichier scellé est une valeur d'origine non contrôlée de
        # plus (§ Zones sensibles 1, R7), et sa borne est mécanique. C'est le
        # motif que `_parsed_when` et `_parsed_deadline` emploient déjà.
        return None, (
            f"thingskit: identite de code attendue non etablie "
            f"({_rendered(exc)}) : {path!r}\n"
            f"thingskit: execution refusee — lancer {LAUNCHER_HINT}, sinon "
            f"l'acces a la base de Things se ferait sous une identite de "
            f"passage et macOS redemanderait l'autorisation."
        )
    return fields, None


def code_identity_refusal(executable: str | None = None, runner=None,
                          requirement: str | None = None, reader=None) -> str | None:
    """Rend le message de refus, ou `None` si l'interpréteur porte l'identité.

    Le contrôle est fermé par défaut, à DEUX titres : si l'attente n'est pas
    établie (fichier scellé absent ou malformé), et si `codesign` ne peut pas
    être exécuté. `requirement` n'est qu'une couture de test, au même titre
    que `runner` : sur le chemin réel, l'attente vient du bundle.
    """
    executable = executable or sys.executable
    runner = runner or subprocess.run
    subject = requirement
    if requirement is None:
        fields, refusal = expected_code_identity(executable, reader=reader)
        if refusal is not None:
            return refusal
        subject = fields[0]
        requirement = compose_code_requirement(*fields)
    try:
        rc = runner(
            [CODESIGN, "--verify", "--strict", f"-R={requirement}", executable],
            capture_output=True,
            text=True,
            timeout=CODESIGN_TIMEOUT,
        ).returncode
    # Fermé par défaut, et fermé PROPREMENT : tout échec d'invocation devient
    # un refus nommé avec son propre code de sortie. `SubprocessError` couvre
    # le dépassement de délai (`TimeoutExpired`) ; `ValueError` couvre les
    # arguments que `subprocess` rejette avant même de forker (chemin à octet
    # nul). Un traceback rendrait 1, indiscernable d'un échec de `main()`.
    except (OSError, subprocess.SubprocessError, ValueError):
        rc = -1
    if rc == 0:
        return None
    return (
        f"thingskit: interpreteur sans l'identite de code attendue par le "
        f"bundle ({subject!r}) : {executable!r}\n"
        f"thingskit: execution refusee — lancer {LAUNCHER_HINT}, sinon l'acces "
        f"a la base de Things se ferait sous une identite de passage et "
        f"macOS redemanderait l'autorisation."
    )

import urllib.parse
from pathlib import Path

# La base vit dans un dossier dont le suffixe varie d'une installation à
# l'autre : on la résout par glob plutôt que de coder un chemin qui casserait
# au prochain poste.
_GC = Path.home() / "Library/Group Containers/JLMPQHK86H.com.culturedcode.ThingsMac"

# Chemins ABSOLUS, jamais résolus par PATH. Le bundle signé isole
# l'interpréteur de son environnement Python (`-I`, cf. build/bundle.py), mais
# `-I` ne ferme pas `PATH` : une commande invoquée par NOM NU y serait résolue,
# donc détournable par un homonyme déposé dans un répertoire du PATH — et le
# code du stub tournerait sous l'identité de code porteuse du grant TCC
# `kTCCServiceSystemPolicyAppData`. Même classe de défaut que `PYTHONPATH` et
# que le `codesign` du lanceur (build/bundle.py, CODESIGN), avec une
# conséquence plus lourde : ce n'est pas une garde qu'on neutralise, c'est du
# code arbitraire qu'on exécute. Reproduit le 2026-08-18 (stub `osascript`).
OSASCRIPT = "/usr/bin/osascript"
OPEN = "/usr/bin/open"
PGREP = "/usr/bin/pgrep"

# Régime rapide du lanceur (ADR-002). Source de vérité UNIQUE de la partition :
# `build/bundle.py` lit cette constante au build et l'embarque dans le shim
# Mach-O, qui ne porte aucune liste écrite à la main (INV-002-3). Elle n'est
# lue par aucun chemin d'exécution du CLI — c'est une déclaration, pas un
# dispatch.
#
# Le sens de lecture est le cœur de la décision, pas un détail : le shim ne
# connaît QUE cette liste, et disclaime la responsabilité de processus pour
# tout le reste — sous-commande inconnue, absente, invalide, ou simplement
# NOUVELLE. Un oubli ne peut donc coûter qu'une lenteur mesurable — de l'ordre
# de la seconde à CHAQUE appel, surcoût permanent mesuré le 2026-08-21 sur
# toute sous-commande, y compris celles qui n'envoient aucun Apple Event —,
# jamais une régression de consentement `kTCCServiceAppleEvents`, qui serait
# un défaut silencieux découvert par l'utilisateur devant un dialogue. C'est
# ce coût que la partition épargne au chemin chaud.
#
# Le critère d'appartenance n'est PAS « lecture vs écriture » mais « sollicite
# `osascript` ou non » : `create-project` et `add-task` écrivent par schéma
# d'URL (`things:///json` via `/usr/bin/open`) et n'ont aucun besoin
# d'AppleEvents — les taxer serait une erreur de partition. Gardé par balayage
# du graphe d'appel (`tests/test_fast_path_partition.py`), qui exige une
# intersection vide avec l'ensemble des sous-commandes atteignant `osa()`.
FAST_PATH_COMMANDS = frozenset({
    "add-task",
    "agenda",
    "areas",
    "create-project",
    "deeplink",
    "find-task",
    "headings",
    "projects",
    "tasks",
    "uuid",
})

TYPE_TASK, TYPE_PROJECT, TYPE_HEADING = 0, 1, 2

# status: constaté par AppleScript (`status of to do id …`) contre les 3
# valeurs réellement présentes en base le 2026-08-11 — pas déduit de la doc.
STATUS_OPEN, STATUS_CANCELED, STATUS_COMPLETED = 0, 2, 3
STATUS_LABELS = {STATUS_OPEN: "open", STATUS_CANCELED: "canceled",
                 STATUS_COMPLETED: "completed"}


# Classe REFUSÉE, nommée par catégorie Unicode et non par `str.isprintable()`.
# `isprintable()` refuse en plus Zs — les séparateurs d'espace —, et c'était un
# SUR-REFUS : mesuré le 2026-08-26 sur la base Things réelle (902 titres), la
# garde citait 2 titres, et le seul caractère en cause était U+00A0, la
# typographie française devant `?` et `!`. Zéro caractère de classe
# dangereuse ; 100 % de faux positifs en usage réel.
#
# Les 17 `Zs` sont des espaces VISIBLES de largeur non nulle : ils n'exécutent
# rien. Rien du modèle de menace n'y est — l'espace de largeur nulle U+200B et
# l'inversion de lecture U+202E sont Cf, le séparateur de ligne U+2028 est Zl,
# tous refusés ci-dessous. Le résidu qui s'ouvre — un espace cadratin pour
# désaligner du texte — rejoint le résidu « imprimable et trompeur » déjà
# déclaré : il ne s'exécute pas, il induit en erreur.
_REFUSED_CATEGORIES = frozenset({"Cc", "Cf", "Zl", "Zp", "Cs", "Co", "Cn"})


def _refuses(text: str) -> bool:
    """La valeur porte-t-elle un caractère de la classe refusée ?"""
    return any(unicodedata.category(ch) in _REFUSED_CATEGORIES for ch in text)


def _bounded(text: str) -> str:
    """Échappe EN PLACE ce que la classe refuse, sans citer le reste.

    Distinct de `_rendered` par sa destination : il borne un MESSAGE dont une
    partie seulement est d'origine non contrôlée — celui qu'`argparse` compose
    hors de ce module. Citer le message entier le rendrait illisible ; le
    laisser tel quel laisse ESC et CR atteindre le terminal.
    """
    if not _refuses(text):
        return text
    return "".join(ch if not _refuses(ch) else repr(ch)[1:-1] for ch in text)


def _rendered(value) -> str:
    """Rendu BORNÉ d'une valeur d'origine non contrôlée (§ Zones sensibles 1).

    Borne la classe refusée ci-dessus : Cc (dont ESC/CR/LF), Cf (dont
    l'inversion de sens de lecture U+202E), Zl/Zp, Cs/Co/Cn — jamais un filtre
    de caractères énumérés, une liste ne couvrant que ce qu'on a pensé à y
    inscrire. `!r`, employé en prose depuis BUG-005, borne la même classe PLUS
    les séparateurs d'espace : `repr` échappe U+00A0, `_rendered` non. C'est le
    seul écart entre les deux conversions, il est dans le sens du sur-refus, et
    il est déclaré § « ce que le lot ne ferme pas ».

    Ce qu'il ajoute à `!r`, et la seule raison de son existence : il ne cite
    QUE s'il y a lieu. `!r` convient au titre serti dans une phrase — les
    guillemets y délimitent la valeur, et cette délimitation est ce qui borne
    un titre imitant un message du programme. Elle n'apporte rien là où la
    position délimite déjà : une colonne alignée, un identifiant entre
    parenthèses, une ligne destinée à un tube (`uuid`). Y citer
    inconditionnellement coûterait la lisibilité des commandes de lecture, les
    plus utilisées — et refuser une classe qui passe est un défaut au même
    titre que laisser passer une classe qui casse.

    Le partage est donc : `!r` en prose, `_rendered` en position délimitée.
    Les deux bornent la même classe ; le balayage de
    `tests/test_untrusted_rendering.py` les tient pour équivalents.
    """
    text = value if isinstance(value, str) else str(value)
    return repr(text) if _refuses(text) else text


def decode_things_date(v: int | None) -> str | None:
    """startDate / deadline : entier bit-packé, constaté sur le schéma réel.

    year = v >> 16 ; month = (v >> 12) & 0xF ; day = (v >> 7) & 0x1F.
    Vérifié sur les 3 témoins d'un projet réel de la base
    (132811008 -> 2026-08-18, etc.) — pas une conversion présumée.
    """
    if v is None:
        return None
    year = v >> 16
    month = (v >> 12) & 0xF
    day = (v >> 7) & 0x1F
    return f"{year:04d}-{month:02d}-{day:02d}"


def decode_alarm_time(v: int | None) -> str | None:
    """reminderTime : entier = (heure*64+minute) << 20. Les minutes occupent 6
    bits (0-63) : aucune quantification, Things accepte les minutes non
    rondes.

    Mesuré le 2026-08-17 sur 10 valeurs `reminderTime` distinctes réellement
    présentes en base, dont 5 à minutes non rondes (16:15, 16:29, 16:31,
    16:45, 16:59) — l'ancien modèle `(heure*60+minute)//30 << 25` ne
    reconstituait que les 5 valeurs à minutes rondes.
    """
    if v is None:
        return None
    hour, minute = divmod(v >> 20, 64)
    return f"{hour:02d}:{minute:02d}"


# `start` seul ne dit PAS où la tâche apparaît : c'est le couple
# (start, startDate) qui décide. Table MESURÉE le 2026-08-12 en croisant
# l'AppleScript `to dos of list "<libellé>"` avec la base, sur les 606 tâches
# ouvertes — pas déduite de la documentation.
#
#   start=0, sans date -> À classer     start=2, sans date -> Un jour
#   start=1, sans date -> À tout moment start=2, avec date -> À venir
#   start=1, avec date -> Aujourd'hui
#
# Le contresens à éviter : lire `start=2` comme « Un jour » sans regarder la
# date. Une tâche planifiée à une date future porte bien `start=2`, et forcer
# `start=1` ne la « réparerait » pas — ça la ferait basculer dans Aujourd'hui.
START_INBOX, START_ANYTIME, START_SOMEDAY = 0, 1, 2


def scheduling_list(start: int | None, start_date: int | None) -> str | None:
    """Rend la liste Things où la tâche apparaît, ou None si `start` n'est pas
    une des trois valeurs mesurées — on n'invente pas un libellé pour une
    valeur qu'on n'a pas observée. Pure.
    """
    if start == START_INBOX:
        return "inbox"
    if start == START_ANYTIME:
        return "today" if start_date is not None else "anytime"
    if start == START_SOMEDAY:
        return "upcoming" if start_date is not None else "someday"
    return None


def db_path() -> Path:
    hits = sorted(_GC.glob("ThingsData-*/Things Database.thingsdatabase/main.sqlite"))
    if not hits:
        sys.exit("base Things introuvable — l'application est-elle installée ?")
    return hits[0]


def q(sql: str, args: tuple = ()) -> list[tuple]:
    con = sqlite3.connect(f"file:{db_path()}?mode=ro", uri=True)
    try:
        return con.execute(sql, args).fetchall()
    finally:
        con.close()


def osa(script: str) -> tuple[int, str]:
    r = subprocess.run([OSASCRIPT, "-e", script], capture_output=True, text=True)
    return r.returncode, (r.stdout or r.stderr).strip()


def url_open(payload: list, background: bool = True,
             auth_token: str | None = None) -> None:
    """Envoie un payload au schéma d'URL de Things.

    `background=True` (défaut) passe `-g` à `open` : « Do not bring the
    application to the foreground » (man open). Sans lui, chaque écriture
    fait passer Things au premier plan et vole le focus de l'utilisateur.
    Les commandes qui pilotent l'INTERFACE (menus, frappe clavier) doivent
    passer `background=False` — elles ont besoin du premier plan.

    `auth_token` n'est requis que par les opérations `update` du schéma d'URL
    (mesuré le 2026-08-27 : une `update` sans jeton est un NO-OP SILENCIEUX et
    `open` rend malgré tout 0). C'est un SECRET.

    **Cette fonction a porté une affirmation fausse, et il faut la lire pour
    savoir ce qu'elle garde vraiment.** Elle disait « aucune branche, de succès
    comme d'échec, ne cite l'URL construite ici » — vrai des branches Python,
    faux de l'effet observable. `subprocess.run(argv, check=False)` sans
    capture laisse le fils hériter des descripteurs 1 et 2, et `open` imprime
    l'URL entière, jeton compris, quand LaunchServices ne résout pas le
    schéma. Une affirmation d'établissement qui survit à sa réfutation est
    pire que son absence.

    Ce qui est vrai APRÈS correction, et mesuré : la sortie du processus fils
    est capturée sur TOUS les chemins, avec ou sans jeton ; sur échec, seul le
    CODE RETOUR est cité, jamais l'URL ni la sortie brute. Gardé par
    `tests/test_url_scheme_token.py`, qui exerce le vrai `subprocess.run`
    contre un `open` jetable et lit les DESCRIPTEURS — un test qui remplace la
    frontière qu'il prétend garder ne garde rien.
    """
    params = []
    if auth_token:
        params.append("auth-token=" + urllib.parse.quote(auth_token))
    params.append("data=" + urllib.parse.quote(
        json.dumps(payload, ensure_ascii=False)))
    url = "things:///json?" + "&".join(params)
    argv = [OPEN] + (["-g"] if background else []) + [url]
    # La sortie du fils est CAPTURÉE, toujours. Sans capture il hérite des
    # descripteurs 1 et 2 du parent, et `open` imprime l'URL COMPLÈTE — jeton
    # compris — sur son stderr quand LaunchServices ne résout pas le schéma
    # (mesuré le 2026-08-27 avec un `open` substitué). La branche est
    # atteignable en usage nominal : `ensure_running()` ne s'arrête pas quand
    # l'application ne démarre pas. La capture porte sur la CLASSE — la sortie
    # d'un fils qui s'échappe — et non sur la seule invocation qui porte le
    # secret : une URL sans jeton porte quand même les titres de l'utilisateur.
    r = subprocess.run(argv, check=False, capture_output=True, text=True)
    if r.returncode != 0:
        # Capturer sans rien dire changerait un défaut visible en défaut muet.
        # Le code retour suffit à diagnostiquer ; la sortie brute, elle, est
        # RETENUE parce qu'elle cite l'URL. Rien de ce que le fils a écrit ne
        # traverse cette ligne.
        # `_rendered` sur un entier est CÉRÉMONIEL et il reste : le balayage
        # d'AST juge le TRAJET d'une valeur, pas son type, et c'est ce qui
        # lui fait attraper les vrais défauts. Le dispenser ici imposerait une
        # exception, c'est-à-dire une liste — qui ne couvre que ce qu'on a
        # pensé à y inscrire. Le prix est nul, la garde reste entière.
        print(f"schéma d'URL : l'ouverture a échoué (code "
              f"{_rendered(r.returncode)}) — "
              "sortie du processus retenue, elle citerait l'URL et donc le "
              "jeton. L'effet reste tranché par la vérification post-action.",
              file=sys.stderr)


def _uri_scheme_token(action_suffix: str) -> tuple[str | None, str | None]:
    """Le jeton du schéma d'URL, LU EN BASE (`mode=ro`), (jeton, erreur).

    Mesuré le 2026-08-27 : Things le stocke dans
    `TMSettings.uriSchemeAuthenticationToken`. Il n'impose donc AUCUNE
    configuration à l'utilisateur, et n'a pas à vivre dans une variable
    d'environnement ni dans un fichier de configuration — c'est ce qui
    distingue ce cas de `reschedule-task`, où la même surface avait été
    écartée faute de jeton accessible (§ Conventions réelles, « la surface
    préférée est celle qui marche SANS configuration de l'utilisateur »).

    Un jeton ABSENT ou VIDE est refusé AVANT tout envoi : mesuré, une
    opération `update` sans jeton est un NO-OP SILENCIEUX et `open` rend
    malgré tout 0 — le mode d'échec « commande envoyée ≠ effet constaté »
    sous sa forme la plus trompeuse, et le seul endroit où il est arrêtable
    est en amont.

    Le jeton est un SECRET. Ce que cette fonction garantit, et rien de plus :
    elle le REND à l'appelant et ne l'imprime pas — son message de refus se
    compose du contexte, jamais de la valeur lue. La propriété « il ne sort
    sur aucune sortie » ne se tient PAS ici : elle se tient dans `url_open`,
    seul endroit où le jeton quitte le processus, et elle y a été fausse
    jusqu'au 2026-08-27 (le processus fils l'imprimait). Une propriété
    s'affirme là où elle est tenue, sinon deux endroits se renvoient la
    responsabilité et personne ne la porte.
    """
    try:
        rows = q("select uriSchemeAuthenticationToken from TMSettings")
    except sqlite3.Error:
        rows = []
    token = rows[0][0] if rows and rows[0][0] else None
    if not token:
        return None, ("jeton du schéma d'URL Things introuvable — l'activer "
                      "dans Things > Réglages > Général > « Activer les URL "
                      f"Things », {action_suffix}. Sans lui l'ordre serait "
                      "ignoré en silence et la commande annoncerait un "
                      "déplacement qui n'a pas eu lieu.")
    return token, None


# ---------------------------------------------------------------------------
# Attente post-écriture : boucle de relecture bornée (BUG-016, 2026-08-25)
# ---------------------------------------------------------------------------
# Chaque commande d'écriture attendait une durée FIXE avant de relire la base
# pour constater son effet. Mesuré le 2026-08-25 (Mac Studio, Things 3.23,
# sondage de `main.sqlite` toutes les 25 ms, plafond 10 s, 10 tâches jetables) :
#
#   création par schéma d'URL    n=5    médiane  11 ms   max   66 ms
#   création par AppleScript     n=5    médiane  13 ms   max   14 ms
#   renommage                    n=10   médiane  11 ms   max   14 ms
#   complétion                   n=10   médiane  11 ms   max   14 ms
#   mise à la Corbeille          n=10   médiane  23 ms   max 5026 ms
#
# Une durée devinée est fautive DANS LES DEUX SENS. Trop longue dans le cas
# courant — 1500 à 2500 ms pour un effet enregistré en 11 ms, soit ~130x. Trop
# COURTE sur la queue : la suppression mesurée à 5026 ms dépassait le plafond
# de 1500 ms, la relecture tombait avant l'enregistrement, et la commande
# sortait en échec sur une écriture qui avait pourtant réussi. C'est le mode
# d'échec le plus coûteux du lot : l'appelant qui réessaie sur échec produit un
# doublon dans la base réelle de l'utilisateur (§ Zones sensibles 1).
#
# POLL_INTERVAL — 25 ms. C'est l'intervalle avec lequel les chiffres ci-dessus
#   ont été mesurés, donc le seul pour lequel ils valent directement. Il vaut
#   ~2x la médiane de 11 ms : le cas courant est constaté au premier ou au
#   deuxième sondage. Le sondage lui-même coûte 0,7 ms (médiane sur 50 lectures
#   de la vraie base, 1122 lignes, mesuré le 2026-08-25) — 3 % de l'intervalle,
#   donc le temps réellement écoulé ne dépasse le plafond nominal que de
#   quelques pour cent.
#
# WRITE_TIMEOUT — 15 s, soit près de 3x la seule queue observée (5026 ms). La
#   marge est délibérément asymétrique, parce que les deux erreurs ne coûtent
#   pas la même chose. Un plafond trop BAS reconvertit une écriture réussie en
#   échec, et se paie dans les données de l'utilisateur (doublon) ; trop HAUT,
#   il ne coûte que de la latence, et seulement sur un chemin déjà défaillant. Les
#   5026 ms étant un échantillon UNIQUE, la distribution de la queue est
#   inconnue : la marge se prend du côté qui ne casse rien. 15 s reste très en
#   deçà du seuil où un appelant conclurait que le CLI est pendu — c'est la
#   raison d'être d'un plafond, même motif que `CODESIGN_TIMEOUT`.
#
# LAUNCH_TIMEOUT — 6 s, inchangé : c'est l'ancienne attente fixe de
#   `ensure_running`, conservée comme PLAFOND pour ne pas aggraver le pire cas.
#   Seule la médiane change (le lancement est constaté, plus attendu).
POLL_INTERVAL = 0.025
WRITE_TIMEOUT = 15.0
LAUNCH_POLL_INTERVAL = 0.1
LAUNCH_TIMEOUT = 6.0

# AFFICHAGE de `create-heading` — condition OBSERVÉE, plus durée devinée.
#
# Le clic « Fichier > Nouvel en-tête » s'applique à la FENÊTRE AU PREMIER
# PLAN. Rien ne garantissait qu'elle affiche le projet visé : on envoyait
# `things:///show?id=<uuid>`, puis on attendait 1 s. Sur `master` cette
# seconde venait après les 6 s fixes de `ensure_running` — ~7 s de marge sur
# un démarrage à froid. Depuis que le lancement est CONSTATÉ par `pgrep`, il
# ne restait qu'elle, et `pgrep` observe l'existence du processus, jamais
# l'avancement du lancement.
#
# Mesuré le 2026-08-25 (Mac Studio, Things 3.23, 3 démarrages à froid,
# application quittée entre chaque) :
#
#   `pgrep -x Things3` matche à              57, 61, 62 ms
#   la fenêtre affiche enfin le projet à    795, 846, 970 ms
#   marge restante avant le clic            ~130 à ~305 ms   (~6,9 s sur master)
#
# Le défaut ne s'est pas reproduit sur ces trois essais — la marge a suffi.
# C'est la marge elle-même qui avait fondu d'un facteur ~25 sur une opération
# dont le pire cas dépend de la charge du poste et de la synchronisation
# iCloud au lancement ; et son mode d'échec est celui que la constitution
# nomme en § Zones sensibles 2 : le titre tapé dans le mauvais projet, effet
# de bord irréversible que la vérification post-action constate sans pouvoir
# le défaire.
#
# Cette condition n'a AUCUNE trace en base — il n'y a rien à relire. Elle est
# en revanche observable par la surface applicative : `name of window 1` rend
# le nom de la liste affichée (mesuré : « Aujourd'hui » avant l'URL, le titre
# du projet après). Les deux propriétés cachées du dictionnaire, `current
# list url` et `current list name`, rendent `missing value` sur cette
# version : mesurées, écartées, pas déduites.
#
# HEADING_VIEW_TIMEOUT — 15 s, PLAFOND, pas attente : même valeur et même
#   motif que `WRITE_TIMEOUT`, soit ~15x le pire affichage mesuré. Une marge
#   asymétrique, du côté qui ne casse rien : trop bas, il refuserait un
#   affichage lent et l'appelant réessaierait.
# HEADING_VIEW_POLL_INTERVAL — 100 ms. La sonde est un AppleEvent (~80 ms
#   mesuré à chaud), pas une lecture SQLite de 0,7 ms : sonder aux 25 ms de
#   `POLL_INTERVAL` reviendrait à sonder en continu.
# HEADING_VIEW_PROBE_TIMEOUT — 5 s, borne de l'AppleEvent LUI-MÊME. Établi
#   sur pièce le 2026-08-25 : un AppleEvent adressé à une application en
#   cours de lancement ne rend PAS `-600`, il BLOQUE jusqu'à pouvoir être
#   servi (699, 753 et 854 ms mesurés, rc=0). Sans cette borne, l'attente
#   serait bornée par le délai d'AppleEvent par défaut d'`osascript` (120 s)
#   et le plafond de la boucle ne voudrait plus rien dire.
HEADING_VIEW_TIMEOUT = 15.0
HEADING_VIEW_POLL_INTERVAL = 0.1
HEADING_VIEW_PROBE_TIMEOUT = 5

# Premier plan — SECONDE condition, indépendante de l'affichage.
# HEADING_FRONTMOST_ATTEMPTS x HEADING_FRONTMOST_POLL_INTERVAL = 5 s de
#   DÉLAIS CUMULÉS. Ce produit était annoncé « 5 s de plafond » : c'était
#   faux, rectifié le 2026-08-25. Il ne borne QUE les `delay` — chaque
#   itération émet en plus un AppleEvent (`frontmost of application
#   "Things3"`), borné individuellement à HEADING_VIEW_PROBE_TIMEOUT (5 s)
#   par le `with timeout` englobant, et `osa()` ne passe aucun `timeout=` à
#   `subprocess.run`. Le PIRE CAS réel est donc
#   ATTEMPTS x (HEADING_VIEW_PROBE_TIMEOUT + POLL_INTERVAL) = 505 s, atteint
#   seulement si chacun des 100 sondages épuise ses 5 s. La boucle TERMINE et
#   échoue fermé dans tous les cas : c'est le chiffre qui mentait, pas le
#   mécanisme. Les trois termes sont épinglés ensemble par test
#   (`test_the_frontmost_budget_is_the_delays_alone_not_the_worst_case`) —
#   c'est leur dissociation qui avait produit le chiffre faux.
#   Ce pire cas n'est PAS borné côté Python, et c'est délibéré : `osa()`
#   exécute ici un script qui clique un menu PUIS tape le titre. Le tuer en
#   cours laisserait un en-tête créé sans titre, soit la mutation partielle
#   silencieuse que `_LOST_FOCUS_MARKER` existe pour signaler — on échangerait
#   une attente longue, que l'utilisateur voit, contre un objet vide dans sa
#   base, qu'il ne voit pas.
#   Dans le cas nominal la boucle sort au premier constat vrai et coûte zéro
#   (l'`activate` qui la précède a déjà rendu Things frontmost). Elle remplace
#   le délai fixe de 300 ms qui pariait sur une activation aboutie — poste
#   chargé, dialogue modal d'une autre app, utilisateur qui change de fenêtre :
#   le titre partait alors dans une AUTRE application.
# La borne est un COMPTE D'ITÉRATIONS, pas un `with timeout` : ce dernier
#   borne chaque AppleEvent, jamais la durée d'un `repeat`. Une boucle
#   `repeat until` serait restée non bornée.
HEADING_FRONTMOST_ATTEMPTS = 100
HEADING_FRONTMOST_POLL_INTERVAL = 0.05


def wait_for_effect(probe, timeout: float = WRITE_TIMEOUT,
                    interval: float = POLL_INTERVAL):
    """Sonde `probe` à intervalle court jusqu'à une valeur vraie, ou plafond.

    Rend la dernière valeur rendue par la sonde : vraie = effet constaté,
    fausse = plafond atteint sans constat.

    Cette fonction ne décide RIEN. La vérification post-action et le code
    retour restent au site d'appel — un plafond atteint reste un échec, jamais
    un « commande envoyée » déguisé en succès (§ Zones sensibles 1). Tout ce
    qu'elle change, c'est la DURÉE de l'attente : écourtée quand l'effet est
    déjà là, allongée quand il tarde.

    Le site d'appel compose son message depuis la valeur que la SONDE a
    observée, capturée par fermeture — il ne relit PAS la base. Une seconde
    lecture court après l'effet : s'il atterrit entre le dernier sondage et le
    `print`, elle rend la valeur *attendue*, et le message affirme un échec en
    montrant deux valeurs identiques. La forme est interdite par balayage
    d'AST (`tests/test_write_wait.py`), sur la branche d'échec de chacun des
    14 appels.

    Une erreur de lecture SQLite pendant l'attente vaut « pas encore constaté »,
    jamais « constaté » : la base est écrite par l'application pendant qu'on la
    sonde, et un refus transitoire ne doit pas abréger l'attente — sonder 600
    fois multiplie les occasions d'en rencontrer un, là où l'attente fixe ne
    lisait qu'une fois. Un refus qui PERSISTE jusqu'au plafond ne ressort donc
    nulle part : la sonde n'a simplement jamais rien observé, et les sites qui
    capturent le disent (`_NO_OBSERVATION`) au lieu d'inventer un écart. Les
    autres classes d'erreur, elles, ne sont pas avalées : elles ressortent dès
    le premier sondage (cf. `_probe_once`).
    """
    observed = _probe_once(probe)
    remaining = timeout
    while not observed and remaining > 1e-9:
        nap = min(interval, remaining)
        time.sleep(nap)
        remaining -= nap
        observed = _probe_once(probe)
    return observed


def _probe_once(probe):
    """Un sondage, filet posé sur ce qui est RÉELLEMENT transitoire.

    `sqlite3.OperationalError` seul : c'est la classe des refus de lecture que
    l'écriture concurrente de l'application produit (`database is locked`).
    `sqlite3.Error` couvrait aussi `ProgrammingError` et `InterfaceError` —
    un binding manquant ou une colonne mal nommée devenait alors 15 s de
    boucle muette, suivies d'un message d'échec qui accusait l'application au
    lieu de nommer le défaut. Aucun faux succès possible, mais un diagnostic
    rendu impossible : un défaut de programmation ressort tout de suite.
    """
    try:
        return probe()
    except sqlite3.OperationalError:
        return None


def _observed_status(task_id: str) -> int | None:
    """Statut relu en base, `None` si la ligne a disparu."""
    rows = q("select status from TMTask where uuid=? and type=?",
             (task_id, TYPE_TASK))
    return rows[0][0] if rows else None


# Repli COMMUN aux six sites qui composent leur message depuis la valeur
# capturée par la sonde. Un seul objet, pas six littéraux : six copies d'une
# même phrase divergent à la première reformulation, et le test qui les garde
# ne verrait plus qu'une partie de la classe. Il sert quand la sonde n'a rien
# pu observer de TOUTE l'attente — lecture de la base refusée du premier au
# dernier sondage : il n'y a alors aucun écart à citer, et le dire vaut mieux
# qu'imprimer `None` ou une chaîne vide.
_NO_OBSERVATION = ("aucun écart observé au dernier sondage — lecture de la "
                   "base refusée pendant toute l'attente")


def _status_gap(observed: int | None, expected: int) -> str | None:
    """Écart de statut TEL QUE LA SONDE L'A CONSTATÉ, `None` s'il n'y en a pas.

    Pure : elle ne lit pas la base, elle met en forme ce qui a déjà été lu.
    C'est ce qui permet de l'appeler dans la sonde et d'en garder le résultat
    pour le message, au lieu de redemander à la base ce qu'elle vient de dire.
    """
    if observed == expected:
        return None
    label = ("(ligne absente)" if observed is None
             else _rendered(STATUS_LABELS.get(observed, observed)))
    return (f"statut constaté en base = {label}, attendu "
            f"{STATUS_LABELS.get(expected, expected)!r}")


def ensure_running() -> None:
    """Lance Things s'il ne tourne pas — en arrière-plan (`-g`).

    Une commande d'écriture ne doit jamais faire basculer l'utilisateur hors
    de son application courante. `create-heading`, qui a besoin du premier
    plan, l'obtient par son propre `open` activant, après cet appel.
    """
    if _things3_is_running():
        return
    subprocess.run([OPEN, "-g", "-a", "Things3"], check=False)
    # La lambda n'est pas un ornement : passer `_things3_is_running` par son NOM
    # en ferait une fonction de module employée comme valeur, forme que le
    # balayage de `tests/test_fast_path_partition.py` ne sait pas résoudre. Le
    # test qui en dépend est `test_the_sweep_vouches_for_every_form_in_the_real_script`,
    # dont le résidu exigé est nul — « je ne sais pas lire » ne doit jamais s'y
    # lire « rien à signaler ». Vérifié sur pièce le 2026-08-25 en substituant
    # le nom à la lambda : ce test-là échoue, et lui seul ;
    # `test_no_fast_path_subcommand_reaches_osa` reste vert dans les deux
    # formes, donc la partition du régime rapide n'est PAS en jeu ici.
    if not wait_for_effect(lambda: _things3_is_running(), timeout=LAUNCH_TIMEOUT,
                           interval=LAUNCH_POLL_INTERVAL):
        # Pas un échec de commande : `ensure_running` est une précondition, pas
        # une écriture. On le DIT plutôt que de le taire, et on laisse la
        # vérification post-action de la commande trancher — c'est elle qui
        # porte le contrat « 0 = effet constaté ».
        print(f"Things3 n'est toujours pas lancé après {LAUNCH_TIMEOUT:g} s — "
              "la commande continue, sa vérification post-action tranchera.",
              file=sys.stderr)


def _things3_is_running() -> bool:
    return subprocess.run([PGREP, "-x", "Things3"],
                          capture_output=True).returncode == 0


